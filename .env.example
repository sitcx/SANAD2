# Copy to .env. Variables starting with VITE_ are public and visible in the browser,
# so never put secrets in them. Lines starting with # are off; remove the # to use one.

# --- Agents (Python) — server-side only, never prefix with VITE_ ---
# Enables Claude. Leave empty to use the simple rule-based fallbacks.
ANTHROPIC_API_KEY=

# --- Optional (the defaults work; uncomment only to change) ---
# Address of the agents API used by the web UI.
# VITE_SANAD_API_URL=http://localhost:8010
# Web origins allowed to call the API (comma-separated).
# SANAD_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Port run.py starts the API on.
# SANAD_API_PORT=8010
# Log file path, or "none" for console only. Default: src/logger/logs/sanad.log (config.yaml)
# SANAD_LOG_FILE=src/logger/logs/sanad.log
# Dataset location if not in src/data/dataset.
# SIGN_DATASET_DIR=src/data/dataset
